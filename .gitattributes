# Auto detect text files and perform LF normalization
* text=auto

# Binary game build artifacts — never normalize line endings
*.br binary
*.gz binary
*.wasm binary
*.data binary
*.unityweb binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.webp binary
*.avif binary
*.gif binary
*.apk binary
*.aab binary
*.mp4 binary
*.webm binary
*.fbx binary
*.psd binary
*.pdf binary
